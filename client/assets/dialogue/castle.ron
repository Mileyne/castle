        Line("forgebraise", "prologue_09"),
        Line("samelia", "prologue_10"),
        Line("knight", "prologue_11"),
    ]),
    (id: "intro", steps: [
        Line("samelia", "intro_e0"),
        Line("knight", "intro_01"),
        Line("sorcerer", "intro_02"),
        Line("ranger", "intro_03"),
